# Copy to .env and fill in.

# Replicate — hosts SAM2 (segmentation) and the inpainting generator.
REPLICATE_API_TOKEN=r8_...

# OpenAI — vision-language model that labels each mask.
OPENAI_API_KEY=sk-...

# --- optional overrides (defaults shown in app/config.py) -------------------
# SAM2_MODEL=meta/sam-2
# VLM_MODEL=gpt-4o
# INPAINT_MODEL=stability-ai/stable-diffusion-inpainting

# Cost control: each surviving mask costs one VLM call.
# MAX_MASKS=24
# MIN_MASK_AREA_FRAC=0.004

# Cushion (px) that locked regions are grown by before generation.
# LOCKED_DILATION_PX=12

# Flip if your inpainting endpoint treats BLACK as "repaint this".
# INVERT_INPAINT_MASK=false

# --- the free path: one key, no card. aistudio.google.com/apikey -----------
GOOGLE_API_KEY=

# --- the door on the studio (blank = no door) ------------------------------
STUDIO_ACCESS_CODE=
SESSION_SECRET=
